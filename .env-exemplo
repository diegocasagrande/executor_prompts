# Copie este arquivo para .env e preencha. O .env NÃO deve ser commitado.
# Deixe vazia a chave de um fornecedor que você não vai usar: ele será ignorado.

# --- Chaves de API ---
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Identificação do dono de cada chave (gravada na coluna "Dono da API") ---
GEMINI_DONO=
ANTHROPIC_DONO=
OPENAI_DONO=

# --- Planilha ---
# Pasta com os arquivos PromptExecucoesSumario_vNNNNN.xlsx (relativa à raiz do projeto)
PASTA_PLANILHAS=planilha
PREFIXO_PLANILHA=PromptExecucoesSumario

# --- Execução ---
# Tentativas por chamada em erros transitórios (429, 5xx, sobrecarga)
MAX_TENTATIVAS=5
